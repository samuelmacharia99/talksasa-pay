# Re-decrypts Talksasa Pay secrets into tmpfs at boot (they never touch disk,
# so they are gone after a restart). Installed by deploy/host/apply.sh.
[Unit]
Description=Talksasa Pay secrets for %i
Before=docker.service
After=local-fs.target
ConditionPathExists=/opt/talksasa-pay/%i/current

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'exec /opt/talksasa-pay/%i/current/host/apply.sh secrets %i'

[Install]
WantedBy=multi-user.target
