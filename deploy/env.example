# Non-secret settings for one environment. Copy to the deploy host as
#   /etc/talksasa-pay/<env>.env      (root 0644)
# Secrets do NOT go here: they live in secrets/<env>.enc.yaml (SOPS + age).

# Public hostnames (DNS A/AAAA records must point at the host before the
# first deploy so Caddy can obtain certificates).
TSP_PAY_DOMAIN=pay.talksasa.co.ke
TSP_ADMIN_DOMAIN=payadmin.talksasa.co.ke
TSP_API_DOMAIN=payapi.talksasa.co.ke
TSP_ACME_EMAIL=tech@talksasa.co.ke

# Who may open the staff panel: office IPs / VPN ranges, space separated.
# Required. Use "0.0.0.0/0 ::/0" only if you accept the panel being public
# (it still needs password + authenticator).
TSP_ADMIN_ALLOW_CIDRS=203.0.113.10/32

# The Talksasa paybill shown on pay pages (5-7 digits).
TSP_MPESA_PAYBILL=000000

# M-Pesa (Safaricom Daraja: STK push, STK query, C2B). Empty or unset turns
# M-Pesa off (pay page shows only the paybill steps; no callbacks). When set,
# the bundle secrets/<env>.enc.yaml MUST contain mpesa_consumer_key,
# mpesa_consumer_secret, mpesa_passkey and mpesa_callback_token (see
# docs/runbooks/secrets.md); apply.sh refuses to deploy otherwise.
# sandbox | production (production is required when TSP_ENV=production).
TSP_MPESA_ENV=
# BusinessShortCode for STK push; defaults to TSP_MPESA_PAYBILL. The sandbox
# uses Safaricom's test shortcode 174379.
# TSP_MPESA_SHORTCODE=174379
# Public base Safaricom calls back (Caddy routes /cb/* on the API domain).
# Defaults to https://$TSP_API_DOMAIN/ ; must end in "/".
# TSP_MPESA_CALLBACK_BASE_URL=https://payapi.talksasa.co.ke/
# Safaricom's callback source networks (comma separated). Required with
# TSP_MPESA_ENV=production; empty accepts any source (sandbox only). Take the
# current list from Safaricom (the value below is an example only); the
# callback token is checked either way.
# TSP_MPESA_CALLBACK_CIDRS=196.201.214.200/32,196.201.214.206/32

# Optional
# TSP_LOG_LEVEL=info
# TSP_NET=172.30.20          # internal /24 for the containers
# TSP_HTTP_PORT=80
# TSP_HTTPS_PORT=443
# TSP_METRICS_PORT=9464      # api metrics, bound to 127.0.0.1 only
# TSP_WORKER_METRICS_PORT=9465  # worker /metrics + /healthz, 127.0.0.1 only
# TSP_BACKUP_KEEP=30         # pre-deploy database dumps to keep
