# Non-secret settings for one environment. Copy to the deploy host as
#   /etc/talksasa-pay/<env>.env      (root 0644)
# Secrets do NOT go here: they live in secrets/<env>.enc.yaml (SOPS + age).

# Public hostnames (DNS A/AAAA records must point at the host before the
# first deploy so Caddy can obtain certificates).
TSP_PAY_DOMAIN=pay.talksasa.co.ke
TSP_ADMIN_DOMAIN=payadmin.talksasa.co.ke
TSP_API_DOMAIN=payapi.talksasa.co.ke
TSP_ACME_EMAIL=tech@talksasa.co.ke

# Who may open the staff panel: office IPs / VPN ranges, space separated.
# Required. Use "0.0.0.0/0 ::/0" only if you accept the panel being public
# (it still needs password + authenticator).
TSP_ADMIN_ALLOW_CIDRS=203.0.113.10/32

# The Talksasa paybill shown on pay pages (5-7 digits).
TSP_MPESA_PAYBILL=000000

# Optional
# TSP_LOG_LEVEL=info
# TSP_NET=172.30.20          # internal /24 for the containers
# TSP_HTTP_PORT=80
# TSP_HTTPS_PORT=443
# TSP_METRICS_PORT=9464      # bound to 127.0.0.1 only
# TSP_BACKUP_KEEP=30         # pre-deploy database dumps to keep
